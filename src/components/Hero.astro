---
import heroImage from "../assets/bg-hero.png";
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap"
  rel="stylesheet"
/>
<search id="home"></search>
<div
  class="the-div flex justify-center relative h-screen overflow-hidden"
  style={`background-image: url(${heroImage.src}); background-size: cover; background-position: center;`}
>
  <div class="absolute inset-0 bg-black/70"></div>

  <div
    class="absolute bottom-0 left-0 right-0 h-[10%] bg-gradient-to-t from-black to-transparent"
  >
  </div>

  <div class="relative h-full flex items-center justify-center flex-col gap-4">
    <p
      class="bg-black px-4 py-2 rounded-[48px] text-stone-400 border border-[#3F3E3E] flex gap-2 items-center text-sm"
    >
      <span class="relative flex h-3 w-3">
        <span
          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#98D517] opacity-75"
        ></span>
        <span class="relative inline-flex rounded-full h-3 w-3 bg-[#98D517]"
        ></span>
      </span>UI/UX Designer & Web developer
    </p>
    <h1
      class="text-transparent bg-clip-text bg-gradient-to-r from-neutral-50 to-neutral-400 text-5xl md:text-6xl lg:text-7xl text-center leading-tight px-4"
    >
      Crafting digital
      <span
        class="text-[#98D517] italic"
        style="font-family: 'Instrument Serif', serif;"
      >
        experiences
      </span>
      <br /> that convert and inspire
    </h1>
    <p class="text-stone-400 text-center text-base sm:text-lg px-4 max-w-2xl">
      I transform complex web challenges into elegant, high-performance <br
        class="hidden sm:inline"
      /> solutions. Every pixel and line of code is designed to drive results.
    </p>
    <a
      href="#portfolio"
      class="font-medium bg-neutral-500/20 backdrop-blur-[2px] md:w-fit px-8 py-3 text-white border border-white/20 rounded-full duration-200 text-center hover:shadow-[0px_0px_10px_rgba(255,255,255,0.6)] hover:border-white/60"
    >
      Explore my portfolio
    </a>
  </div>
</div>

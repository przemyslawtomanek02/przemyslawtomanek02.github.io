---
interface Tool {
  name: string;
  icon?: string;
  fallback?: { label: string; color: string };
}

const programmerTools: Tool[] = [
  { name: "HTML", icon: "html5" },
  { name: "CSS", icon: "css" },
  { name: "JavaScript", icon: "javascript" },
  { name: "TypeScript", icon: "typescript" },
  { name: "Bootstrap", icon: "bootstrap" },
  { name: "Tailwind CSS", icon: "tailwindcss" },
  { name: "React", icon: "react" },
  { name: "Astro", icon: "astro" },
  { name: "Python", icon: "python" },
  { name: "Flask", icon: "flask" },
  { name: "REST API", fallback: { label: "API", color: "#6366F1" } },
  { name: "Supabase", icon: "supabase" },
  { name: "Git", icon: "git" },
  { name: "GitHub", icon: "github/white" },
  { name: "Linux", icon: "linux" },
];

const designerTools: Tool[] = [
  { name: "Figma", icon: "figma" },
  { name: "Webflow", icon: "webflow" },
  { name: "Framer", icon: "framer" },
  { name: "WordPress", icon: "wordpress" },
  { name: "Photoshop", fallback: { label: "Ps", color: "#31A8FF" } },
  { name: "Illustrator", fallback: { label: "Ai", color: "#FF9A00" } },
  { name: "Lightroom", fallback: { label: "Lr", color: "#31A8FF" } },
  { name: "Canva", fallback: { label: "C", color: "#00C4CC" } },
];
---

<section id="tools" class="w-full bg-black py-24 px-6 md:px-12">
  <div class="mx-auto max-w-7xl">
    <!-- Header -->
    <div class="flex flex-col items-center gap-4 text-center mb-12">
      <span
        class="inline-block bg-black px-4 py-2 rounded-full text-stone-400 border border-[#3F3E3E]"
      >
        Tools
      </span>
      <h1
        class="text-transparent bg-clip-text bg-gradient-to-r from-white to-neutral-400 font-medium text-4xl md:text-5xl text-center leading-tight pb-2"
      >
        Tools & Software
      </h1>
      <p class="text-stone-400 text-center leading-relaxed max-w-xl">
        The most crucial tools I use every day to deliver great value.
      </p>
    </div>

    <!-- Toggle -->
    <div class="flex justify-center mb-10">
      <div
        id="tools-toggle"
        class="inline-flex items-center gap-1 bg-neutral-900/60 border border-neutral-800 rounded-full p-1"
      >
        <button
          type="button"
          data-tab="programmer"
          class="tools-tab-btn active px-5 py-2 rounded-full text-sm font-medium transition-colors duration-200"
        >
          Programmer
        </button>
        <button
          type="button"
          data-tab="designer"
          class="tools-tab-btn px-5 py-2 rounded-full text-sm font-medium transition-colors duration-200"
        >
          Designer
        </button>
      </div>
    </div>

    <!-- Panels -->
    <div class="flex justify-center">
      <div
        class="tools-panel flex flex-wrap justify-center gap-3 max-w-3xl"
        data-panel="programmer"
      >
        {
          programmerTools.map((tool) => (
            <div class="inline-flex items-center gap-2 bg-neutral-900/40 backdrop-blur-md border border-neutral-800 rounded-full px-5 py-3 text-stone-300 hover:border-neutral-700 hover:bg-neutral-900/70 transition-colors">
              {tool.icon ? (
                <img
                  src={`https://cdn.simpleicons.org/${tool.icon}`}
                  alt=""
                  class="w-5 h-5"
                  loading="lazy"
                />
              ) : (
                <span
                  class="w-5 h-5 shrink-0 rounded-full flex items-center justify-center text-[9px] font-bold text-black"
                  style={`background-color:${tool.fallback?.color}`}
                >
                  {tool.fallback?.label}
                </span>
              )}
              <span class="text-sm font-medium">{tool.name}</span>
            </div>
          ))
        }
      </div>

      <div
        class="tools-panel hidden flex-wrap justify-center gap-3 max-w-3xl"
        data-panel="designer"
      >
        {
          designerTools.map((tool) => (
            <div class="inline-flex items-center gap-2 bg-neutral-900/40 backdrop-blur-md border border-neutral-800 rounded-full px-5 py-3 text-stone-300 hover:border-neutral-700 hover:bg-neutral-900/70 transition-colors">
              {tool.icon ? (
                <img
                  src={`https://cdn.simpleicons.org/${tool.icon}`}
                  alt=""
                  class="w-5 h-5"
                  loading="lazy"
                />
              ) : (
                <span
                  class="w-5 h-5 shrink-0 rounded-full flex items-center justify-center text-[9px] font-bold text-black"
                  style={`background-color:${tool.fallback?.color}`}
                >
                  {tool.fallback?.label}
                </span>
              )}
              <span class="text-sm font-medium">{tool.name}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .tools-tab-btn {
    color: var(--color-stone-400, #a8a29e);
  }
  .tools-tab-btn.active {
    background-color: rgba(255, 255, 255, 0.08);
    color: #fff;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const toggle = document.getElementById("tools-toggle");
    if (!toggle) return;

    const buttons =
      toggle.querySelectorAll<HTMLButtonElement>(".tools-tab-btn");
    const panels = document.querySelectorAll<HTMLElement>(".tools-panel");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.dataset.tab;

        buttons.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");

        panels.forEach((panel) => {
          if (panel.dataset.panel === target) {
            panel.classList.remove("hidden");
            panel.classList.add("flex");
          } else {
            panel.classList.add("hidden");
            panel.classList.remove("flex");
          }
        });
      });
    });
  });
</script>

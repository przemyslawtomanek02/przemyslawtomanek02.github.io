---
import logo from "../assets/logo-1.svg";
---

<div class="text-sm text-white w-full sticky top-0 z-50">
  <nav>
    <div
      class="relative h-[100px] flex items-center justify-between px-8 md:px-12 py-4 bg-black/50 backdrop-blur-lg text-gray-100 transition-all shadow"
    >
      <a href="#">
        <img src={logo.src} alt="logo" class="h-12" />
      </a>

      <div class="flex items-center justify-end">
        <ul
          class="hidden md:flex items-center space-x-6 text-lg text-strong font-medium"
        >
          <li>
            <a
              href="#home"
              class="text-md text-stone-50 hover:text-green-50 transition-colors"
              >Home</a
            >
          </li>
          <li>
            <a
              href="#services"
              class="text-md text-stone-50 hover:text-green-50 transition-colors"
              >Services</a
            >
          </li>
          <li>
            <a
              href="#portfolio"
              class="text-md text-stone-50 hover:text-green-50 transition-colors"
              >Portfolio</a
            >
          </li>
          <li>
            <a
              href="#blog"
              class="text-md text-stone-50 hover:text-green-50 transition-colors"
              >Blog</a
            >
          </li>
        </ul>

        <div class="hidden md:block">
          <a
            href="#contact"
            class="text-[18px] font-medium bg-neutral-500/20 backdrop-blur-[2px] md:w-fit px-8 py-3 text-white border border-white/20 rounded-full ml-6 duration-200 text-center hover:shadow-[0px_0px_10px_rgba(255,255,255,0.6)] hover:border-white/60"
          >
            Contact
          </a>
        </div>

        <button
          aria-label="menu-btn"
          type="button"
          class="menu-btn inline-block md:hidden active:scale-90 transition"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="30"
            height="30"
            viewBox="0 0 30 30"
            fill="white"
          >
            <path
              d="M3 7a1 1 0 1 0 0 2h24a1 1 0 1 0 0-2zm0 7a1 1 0 1 0 0 2h24a1 1 0 1 0 0-2zm0 7a1 1 0 1 0 0 2h24a1 1 0 1 0 0-2z"
            ></path>
          </svg>
        </button>
      </div>

      <!-- Mobile menu -->
      <div
        class="mobile-menu absolute top-[100%] left-0 w-full bg-black backdrop-blur-md border-t border-white/10 p-6 hidden md:hidden flex-col items-center gap-6"
      >
        <ul class="flex flex-col space-y-4 text-lg text-center w-full">
          <li>
            <a
              href="#home"
              class="block w-full py-2 text-md text-stone-50 hover:text-green-50 transition-colors"
              >Home</a>
          </li>
          <li>
            <a
              href="#services"
              class="block w-full py-2 text-md text-stone-50 hover:text-green-50 transition-colors"
              >Services</a>
          </li>
          <li>
            <a
              href="#portfolio"
              class="block w-full py-2 text-md text-stone-50 hover:text-green-50 transition-colors"
              >Portfolio</a>
          </li>
          <li>
            <a
              href="#blog"
              class="block w-full py-2 text-md text-stone-50 hover:text-green-50 transition-colors"
              >Blog</a>
          </li>
        </ul>

        <a
          href="#contact"
          class="w-full text-[18px] font-medium bg-neutral-500/20 backdrop-blur-[2px] md:w-fit px-8 py-3 text-white border border-white/20 rounded-full duration-200 text-center hover:shadow-[0px_0px_10px_rgba(255,255,255,0.6)] hover:border-white/60"
        >
          Contact
        </a>
      </div>
    </div>
    <div
      class="w-full h-px bg-gradient-to-r from-transparent via-neutral-100/40 to-transparent"
    >
    </div>
  </nav>

  <script>
    const menuButtons = document.querySelectorAll(".menu-btn");
    const mobileMenus = document.querySelectorAll(".mobile-menu");

    menuButtons.forEach((btn, index) => {
      btn.addEventListener("click", () => {
        mobileMenus[index].classList.toggle("hidden");
        mobileMenus[index].classList.toggle("flex");
      });
    });
  </script>
</div>

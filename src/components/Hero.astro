---
import heroImage from "../assets/bg-hero.png";
---

<search id="home"></search>
<div
  class="the-div flex justify-center relative h-screen overflow-hidden"
  style={`background-image: url(${heroImage.src}); background-size: cover; background-position: center;`}
>
  <div class="absolute inset-0 bg-black/80"></div>

  <div
    class="absolute bottom-0 left-0 right-0 h-[10%] bg-gradient-to-t from-black to-transparent"
  >
  </div>

  <div class="relative h-full flex items-center justify-center flex-col gap-4">
    <p
      class="bg-black px-4 py-2 rounded-[48px] text-stone-400 border border-[#3F3E3E] flex gap-2 items-center text-sm"
    >
      <span class="relative flex h-3 w-3">
        <span
          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#98D517] opacity-75"
        ></span>
        <span class="relative inline-flex rounded-full h-3 w-3 bg-[#98D517]"
        ></span>
      </span><span data-i18n="hero.badge">Seeking Full-time IT Role</span>
    </p>
    <h1
      class="tracking-[-2px] text-transparent bg-clip-text bg-gradient-to-r from-white to-neutral-400 text-5xl md:text-6xl lg:text-7xl text-center leading-tight px-4"
    >
      <span data-i18n="hero.titleLine1">Designing and building</span> <span class="font-medium tracking-[-2px]" data-i18n="hero.titleEmphasis"
        >digital products</span
      >
      <br /> <span data-i18n="hero.titleLine2">that teams can rely on</span>
    </h1>
    <p class="text-stone-400 text-center text-base sm:text-lg px-4 max-w-2xl" data-i18n="hero.subtitle">
      I'm a UI/UX Designer & Web Developer looking to bring thoughtful design
      and solid engineering to a product team full-time.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 px-4">
      <a
        href="#portfolio"
        class="font-medium bg-neutral-500/20 backdrop-blur-[2px] md:w-fit px-8 py-3 text-white border border-white/20 rounded-full duration-200 text-center hover:shadow-[0px_0px_10px_rgba(255,255,255,0.6)] hover:border-white/60"
        data-i18n="hero.cta1"
      >
        Explore my portfolio
      </a>
      <a
        href="https://drive.google.com/drive/folders/1welhQfdhVrfKdmJAiE_OmM1M3cL9PfrY?usp=sharing"
        target="_blank"
        class="font-medium bg-[#98D517] md:w-fit px-8 py-3 text-black border border-[#98D517] rounded-full duration-200 text-center hover:shadow-[0px_0px_10px_rgba(152,213,23,0.6)] hover:brightness-110"
        data-i18n="hero.cta2"
      >
        Download CV
      </a>
    </div>
  </div>
</div>

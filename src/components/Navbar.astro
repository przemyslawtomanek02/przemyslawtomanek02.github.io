---
import logo from '../assets/logo-1.svg';
---

<div class="text-sm text-white w-full sticky top-0 z-50">
   <nav class="relative h-[100px] flex items-center justify-between px-6 py-4 bg-black backdrop-blur-sm text-gray-100 transition-all shadow">
    <a href="#">
         <img src={logo.src} alt="logo" class="h-12 md:h-15" />
       </a>
    <div class="flex align-center space-between">
       <ul class="hidden md:flex items-center space-x-6 text-lg text-strong font-medium">
                <li><a href="#" class="text-md text-stone-50 hover:text-green-50 transition-colors">Home</a></li>
               <li><a href="#" class="text-md text-stone-50 hover:text-green-50 transition-colors">Services</a></li>
               <li><a href="#" class="text-md text-stone-50 hover:text-green-50 transition-colors">Portfolio</a></li>
               <li><a href="#" class="text-md text-stone-50 hover:text-green-50 transition-colors">Blog</a></li>
       </ul>
       
       <a href="#contact" class="hidden md:inline-flex relative items-center px-14 py-3 overflow-hidden text-lg font-medium text-green-50 border-1 border-green-50 rounded-full hover:text-stone-950 group ml-8 ">
           <span class="absolute left-0 block w-full h-0 transition-all bg-green-50 opacity-100 group-hover:h-full top-1/2 group-hover:top-0 duration-400 ease"></span>
           <span class="absolute right-0 flex items-center justify-start w-10 h-10 duration-300 transform translate-x-full group-hover:translate-x-0 ease">
               <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                   <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
               </svg>
           </span>
           <span class="relative">Contact</span>
       </a>
       

       <button aria-label="menu-btn" type="button" class="menu-btn inline-block md:hidden active:scale-90 transition">
           <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 30 30" fill="white">
               <path d="M3 7a1 1 0 1 0 0 2h24a1 1 0 1 0 0-2zm0 7a1 1 0 1 0 0 2h24a1 1 0 1 0 0-2zm0 7a1 1 0 1 0 0 2h24a1 1 0 1 0 0-2z"/>
           </svg>
       </button>
    </div>
       

       <div class="mobile-menu absolute top-[80px] left-0 w-full bg-black backdrop-blur-md shadow-sm p-6 hidden md:hidden">
           <ul class="flex flex-col space-y-4 text-lg text-center">
               <li><a href="#" class="text-md text-stone-50 hover:text-green-50 transition-colors">Home</a></li>
               <li><a href="#" class="text-md text-stone-50 hover:text-green-50 transition-colors">Services</a></li>
               <li><a href="#" class="text-md text-stone-50 hover:text-green-50 transition-colors">Portfolio</a></li>
               <li><a href="#" class="text-md text-stone-50 hover:text-green-50 transition-colors">Blog</a></li>
           </ul>

          <a href="" class="inline-flex items-center justify-center w-full md:w-auto relative px-12 py-3 overflow-hidden text-lg font-medium text-green-50 border-2 border-green-50 rounded-full hover:text-stone-950 group md:ml-20 transition-all mt-5">
              <span class="absolute left-0 block w-full h-0 transition-all bg-green-50 opacity-100 group-hover:h-full top-1/2 group-hover:top-0 duration-400 ease"></span>
              <span class="absolute right-0 flex items-center justify-start w-10 h-10 duration-300 transform translate-x-full group-hover:translate-x-0 ease">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                  </svg>
              </span>
              <span class="relative">Contact</span>
          </a>
       </div>
   </nav>
</div>

<script>
   const menuButtons = document.querySelectorAll('.menu-btn');
   const mobileMenus = document.querySelectorAll('.mobile-menu');

   menuButtons.forEach((btn, index) => {
       btn.addEventListener('click', () => {
           mobileMenus[index].classList.toggle('hidden');
       });
   });
</script>
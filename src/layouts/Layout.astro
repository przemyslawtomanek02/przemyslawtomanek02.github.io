---
import "../styles/global.css";
import logo from "../assets/logo-1.svg";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={logo.src} />
    <link
      href="https://api.fontshare.com/v2/css?f[]=satoshi@1,900,700,500,300,400&display=swap"
      rel="stylesheet"
    />
    <title>Przemyslaw Tomanek Programmer UI/UX Designer</title>
  </head>
  <body class="pl-2 pr-2 antialiased">
    <slot />
  </body>
</html>

<style>
  html,
  body {
    font-family: "Satoshi", sans-serif;
    background-color: black;
    color: white;
  }
</style>

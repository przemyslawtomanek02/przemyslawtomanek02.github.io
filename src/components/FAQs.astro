---
import faqImage from "../assets/faq-bg.png";
import faqArrow from "../assets/faq-arrow.svg";

const faqs = [
  {
    question: "What technologies do you know best?",
    answer:
      "On the development side: HTML, CSS, JavaScript, TypeScript, React, Astro, Python, Flask, Supabase, Git/GitHub, and Linux. On the design side: Figma, Webflow, Framer, WordPress, and the Adobe suite (Photoshop, Illustrator). I'm comfortable working across the full stack, from UI design to implementation.",
    defaultOpen: true,
  },
  {
    question: "What does your workflow look like within a development team?",
    answer:
      "My work so far has been largely independent, but I value feedback highly — I believe any feedback is better than none. Regardless of the project, what matters most to me is what the end user actually gets out of it and how they use it, since that's what truly determines a project's value. For day-to-day communication I've mainly used Slack and Outlook.",
    defaultOpen: false,
  },
  {
    question: "What type of employment are you looking for?",
    answer:
      "I'm open to any form of employment — UoP, umowa zlecenie, or umowa o dzieło — working remotely or hybrid, based in Poland or remotely for international companies.",
    defaultOpen: false,
  },
  {
    question: "How soon can you join a new team or project?",
    answer: "Immediately — I'm available to start right away.",
    defaultOpen: false,
  },
  {
    question: "Do you have experience working with a product team or Agile methodology?",
    answer:
      "Yes, on an ongoing basis at New Level Sport, where I work within a product-oriented, iterative process covering UX, development, and store administration.",
    defaultOpen: false,
  },
];
---

<section
  class="relative min-h-screen w-full overflow-hidden bg-black py-20 px-6 md:px-12 subpixel-antialiased"
>
  <!-- Background image -->
  <div
    class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-40 md:bg-contain"
    style={{ backgroundImage: `url(${faqImage.src})` }}
  >
  </div>

  <!-- Gradient overlay -->
  <div
    class="absolute inset-0 bg-[linear-gradient(to_bottom,black_0%,transparent_10%,transparent_90%,black_100%)] pointer-events-none"
  >
  </div>

  <!-- Header -->
  <div
    class="relative h-full mx-auto max-w-7xl flex items-center justify-center flex-col gap-4 px-4"
  >
    <span
      class="inline-block bg-black px-4 py-2 rounded-full text-stone-400 border border-[#3F3E3E]"
    >
      FAQs
    </span>
    <h1
      class="text-transparent bg-clip-text bg-gradient-to-r from-white to-neutral-400 font-medium text-4xl md:text-5xl text-center leading-tight pb-2"
    >
      Frequently asked questions
    </h1>
    <p class="text-stone-400 text-center leading-relaxed">
      Common questions recruiters and hiring teams ask <br /> about my skills and availability.
    </p>
  </div>

  <!-- FAQ List -->
  <div class="flex justify-center mt-16 max-w-3xl mx-auto">
    <div class="flex flex-col gap-4 w-full px-4">
      {
        faqs.map((faq) => (
          <div class="faq-element bg-neutral-900/40 backdrop-blur-md rounded-3xl text-stone-400 border border-neutral-800 p-8">
            <div class="flex justify-between items-center gap-4 cursor-pointer button">
              <h2 class="text-transparent bg-clip-text bg-gradient-to-r from-white to-neutral-400 font-medium text-xl select-none">
                {faq.question}
              </h2>
              <div class="shrink-0">
                <img
                  src={faqArrow.src}
                  alt="toggle"
                  class={`w-8 transition-transform duration-300 ${faq.defaultOpen ? "rotate-0" : "rotate-180"}`}
                />
              </div>
            </div>
            <div class="faq-answer overflow-hidden transition-all duration-400 ease-in-out">
              <p class="pt-4 leading-relaxed">{faq.answer}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>

</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const faqElements = document.querySelectorAll<HTMLElement>(".faq-element");

    faqElements.forEach((el) => {
      const button = el.querySelector<HTMLElement>(".button");
      const answerWrapper = el.querySelector<HTMLElement>(".faq-answer");
      const arrow = el.querySelector<HTMLImageElement>("img");

      if (!button || !answerWrapper || !arrow) return;

      // Determine initial state by arrow rotation
      const isInitiallyOpen = !arrow.classList.contains("rotate-180");

      if (isInitiallyOpen) {
        answerWrapper.style.maxHeight = answerWrapper.scrollHeight + "px";
        answerWrapper.style.opacity = "1";
      } else {
        answerWrapper.style.maxHeight = "0px";
        answerWrapper.style.opacity = "0";
      }

      answerWrapper.style.transition =
        "max-height 0.4s ease, opacity 0.3s ease";

      button.addEventListener("click", () => {
        const isOpen = answerWrapper.style.maxHeight !== "0px";

        // Close all
        faqElements.forEach((other) => {
          const otherAnswer = other.querySelector<HTMLElement>(".faq-answer");
          const otherArrow = other.querySelector<HTMLImageElement>("img");
          if (!otherAnswer || !otherArrow) return;
          otherAnswer.style.maxHeight = "0px";
          otherAnswer.style.opacity = "0";
          otherArrow.classList.remove("rotate-0");
          otherArrow.classList.add("rotate-180");
        });

        // Open clicked if it was closed
        if (!isOpen) {
          answerWrapper.style.maxHeight = answerWrapper.scrollHeight + "px";
          answerWrapper.style.opacity = "1";
          arrow.classList.remove("rotate-180");
          arrow.classList.add("rotate-0");
        }
      });
    });
  });
</script>

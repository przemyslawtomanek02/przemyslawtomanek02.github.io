---
import logo from "../assets/logo-1.svg";
---

<div class="fixed top-0 left-0 right-0 z-50 flex justify-center pointer-events-none">
  <!-- Top edge dissolve: gradient blending nav into the very top of the viewport -->
  <div
    class="absolute top-0 left-0 right-0 h-24 pointer-events-none"
    style="background: linear-gradient(to bottom, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.6) 40%, transparent 100%); mask-image: radial-gradient(ellipse 65% 100% at 50% 0%, black 60%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse 65% 100% at 50% 0%, black 60%, transparent 100%);"
  >
  </div>

  <nav
    class="pointer-events-auto relative w-full md:w-[calc(100%-6rem)] md:max-w-7xl bg-black/55 backdrop-blur-xl rounded-b-3xl border border-t-0 border-white/10 shadow-[0_8px_40px_rgba(0,0,0,0.5)]"
  >
    <!-- Top glow line — dissolving upper edge -->
    <div
      class="absolute top-0 left-[10%] right-[10%] h-px"
      style="background: linear-gradient(to right, transparent, rgba(255,255,255,0.18) 30%, rgba(255,255,255,0.28) 50%, rgba(255,255,255,0.18) 70%, transparent);"
    >
    </div>

    <div class="flex items-center justify-between px-8 py-4">
      <!-- Logo -->
      <a href="#" class="shrink-0">
        <img src={logo.src} alt="logo" class="h-9" />
      </a>

      <!-- Desktop nav links — centered -->
      <ul class="hidden md:flex items-center gap-7 text-sm font-medium">
        <li>
          <a
            href="#home"
            class="text-stone-300 hover:text-white transition-colors duration-200"
            data-i18n="nav.home">Home</a
          >
        </li>
        <li>
          <a
            href="#services"
            class="text-stone-300 hover:text-white transition-colors duration-200"
            data-i18n="nav.services">Services</a
          >
        </li>
        <li>
          <a
            href="#portfolio"
            class="text-stone-300 hover:text-white transition-colors duration-200"
            data-i18n="nav.portfolio">Portfolio</a
          >
        </li>
        <li>
          <a
            href="#blog"
            class="text-stone-300 hover:text-white transition-colors duration-200"
            data-i18n="nav.blog">Blog</a
          >
        </li>
      </ul>

      <!-- Desktop contact button + language toggle -->
      <div class="hidden md:flex items-center gap-3">
        <button
          type="button"
          class="lang-toggle-btn inline-flex items-center justify-center w-10 h-10 text-lg leading-none border border-white/20 rounded-full bg-neutral-500/20 backdrop-blur-sm hover:border-white/50 hover:shadow-[0_0_12px_rgba(255,255,255,0.2)] transition-all duration-200"
          aria-label="Zmień język / Change language"
        >
          <span class="lang-flag-pl" aria-hidden="true">🇵🇱</span>
          <span class="lang-flag-uk hidden" aria-hidden="true">🇬🇧</span>
        </button>
        <a
          href="#contact"
          class="inline-flex items-center text-sm font-medium px-5 py-2 text-white border border-white/20 rounded-full bg-neutral-500/20 backdrop-blur-sm hover:border-white/50 hover:shadow-[0_0_12px_rgba(255,255,255,0.2)] transition-all duration-200"
          data-i18n="nav.contact"
        >
          Contact
        </a>
      </div>

      <!-- Mobile hamburger -->
      <button
        aria-label="menu-btn"
        type="button"
        class="menu-btn md:hidden active:scale-90 transition"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="26"
          height="26"
          viewBox="0 0 30 30"
          fill="white"
        >
          <path
            d="M3 7a1 1 0 1 0 0 2h24a1 1 0 1 0 0-2zm0 7a1 1 0 1 0 0 2h24a1 1 0 1 0 0-2zm0 7a1 1 0 1 0 0 2h24a1 1 0 1 0 0-2z"
          ></path>
        </svg>
      </button>
    </div>

    <!-- Mobile dropdown -->
    <div
      class="mobile-menu hidden flex-col items-center gap-5 pb-6 px-8 border-t border-white/10 pt-5"
    >
      <ul class="flex flex-col gap-4 text-sm text-center w-full">
        <li>
          <a
            href="#home"
            class="block py-1 text-stone-300 hover:text-white transition-colors"
            data-i18n="nav.home">Home</a
          >
        </li>
        <li>
          <a
            href="#services"
            class="block py-1 text-stone-300 hover:text-white transition-colors"
            data-i18n="nav.services">Services</a
          >
        </li>
        <li>
          <a
            href="#portfolio"
            class="block py-1 text-stone-300 hover:text-white transition-colors"
            data-i18n="nav.portfolio">Portfolio</a
          >
        </li>
        <li>
          <a
            href="#blog"
            class="block py-1 text-stone-300 hover:text-white transition-colors"
            data-i18n="nav.blog">Blog</a
          >
        </li>
      </ul>
      <div class="flex items-center gap-3 w-full">
        <button
          type="button"
          class="lang-toggle-btn shrink-0 inline-flex items-center justify-center w-11 h-11 text-lg leading-none border border-white/20 rounded-full bg-neutral-500/20 hover:border-white/50 transition-all duration-200"
          aria-label="Zmień język / Change language"
        >
          <span class="lang-flag-pl" aria-hidden="true">🇵🇱</span>
          <span class="lang-flag-uk hidden" aria-hidden="true">🇬🇧</span>
        </button>
        <a
          href="#contact"
          class="flex-1 text-sm font-medium px-5 py-2.5 text-white border border-white/20 rounded-full text-center bg-neutral-500/20 hover:border-white/50 transition-all duration-200"
          data-i18n="nav.contact"
        >
          Contact
        </a>
      </div>
    </div>
  </nav>
</div>

<script>
  import { initLanguageToggle } from "../i18n/apply";

  initLanguageToggle();

  const menuBtn = document.querySelector(".menu-btn");
  const mobileMenu = document.querySelector(".mobile-menu");

  menuBtn?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");
    mobileMenu?.classList.toggle("flex");
  });

  // Close mobile menu when a link is clicked
  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu.classList.add("hidden");
      mobileMenu.classList.remove("flex");
    });
  });
</script>

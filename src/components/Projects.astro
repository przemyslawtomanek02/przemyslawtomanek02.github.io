---
import dropShoes from "../assets/dropshoe_hero.png";
import projectSectionBg from "../assets/bg-portfolio.png";
import coworkingWebsite from "../assets/coworking_hero.png";
import digitalArtist from "../assets/hero_portfolio_for_digital_artist.png";
---

<section
  class="relative min-h-screen w-full overflow-hidden bg-black py-20 px-6 md:px-12"
  id="portfolio"
>
  <div
    class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-40 md:bg-contain"
    style={{ backgroundImage: `url(${projectSectionBg.src})` }}
  >
  </div>

  <div
    class="absolute inset-0 bg-[linear-gradient(to_bottom,black_0%,transparent_10%,transparent_90%,black_100%)] pointer-events-none"
  >
  </div>
  <div
    class="relative h-full mx-auto flex items-center justify-center flex-col gap-4 px-4"
  >
    <span
      class="inline-block bg-black px-4 py-2 rounded-full text-stone-400 border border-[#3F3E3E]"
    >
      Projects</span
    >
    <h1
      class="text-transparent bg-clip-text bg-gradient-to-r from-neutral-50 to-neutral-400 text-5xl md:text-6xl text-center"
    >
      Few selected
      <span
        class="text-[#98D517] italic"
        style="font-family: 'Instrument Serif', serif;"
      >
        projects
      </span>
    </h1>
    <p class="text-stone-400 text-center leading-relaxed">
      A showcase of innovative solutions that solve real-world digital
      challenges.
    </p>
  </div>
  {/* First project - start section */}
  <div
    class="w-full mt-16 bg-neutral-900/40 backdrop-blur-md rounded-3xl text-stone-400 border border-neutral-800 p-8 md:p-12 grid grid-cols-2 md:grid-cols-3 h-auto gap-6 md:content-center"
  >
    <div class="col-span-2 lg:col-span-1 flex flex-col gap-4 justify-center">
      <h2
        class="text-transparent bg-clip-text bg-gradient-to-r from-neutral-50 to-neutral-400 text-4xl"
      >
        Drop Shoes <span
          class="italic"
          style="font-family: 'Instrument Serif', serif;"><br />ecommerce</span
        > website
      </h2>
      <div class="w-auto gap-2 flex">
        <p
          class="py-1 px-4 bg-black rounded-4xl border-1 border-neutral-700 my-1 w-fit"
        >
          UI Design
        </p>
        <p
          class="py-1 px-4 bg-black rounded-4xl border-1 border-neutral-700 my-1 w-fit"
        >
          UX Design
        </p>
      </div>
      <p>
        A unique online store selling footwear. The layout includes elements
        that increase conversions among Generation Z users. It features a
        dynamic design and unique graphics tailored to the young user.
      </p>
      <a
        href="#"
        class="font-medium bg-neutral-500/20 backdrop-blur-[2px]
 md:w-fit px-8 py-3 text-white border border-white/20 rounded-full duration-200 text-center hover:shadow-[0px_0px_10px_rgba(255,255,255,0.6)] hover:border-white/60"
      >
        Comming soon
      </a>
    </div>
    <div
      class="col-span-3 content-center md:content-center lg:col-span-2 order-first lg:order-none"
    >
      <img src={dropShoes.src} alt="DropShoes" />
    </div>
  </div>
  {/* First project - start section */}
  {/* Second project - start section */}
  <div
    class="w-full mt-16 bg-neutral-900/40 backdrop-blur-md rounded-3xl text-stone-400 border border-neutral-800 p-8 md:p-12 grid grid-cols-2 md:grid-cols-3 h-auto gap-6 md:content-center"
  >
    <div class="col-span-2 lg:col-span-1 flex flex-col gap-4 justify-center">
      <h2
        class="text-transparent bg-clip-text bg-gradient-to-r from-neutral-50 to-neutral-400 text-4xl"
      >
        Website for <span
          class="italic"
          style="font-family: 'Instrument Serif', serif;">coworking</span
        > office
      </h2>
      <div class="w-auto gap-2 flex">
        <p
          class="py-1 px-4 bg-black rounded-4xl border-1 border-neutral-700 my-1 w-fit"
        >
          UI Design
        </p>
        <p
          class="py-1 px-4 bg-black rounded-4xl border-1 border-neutral-700 my-1 w-fit"
        >
          UX Design
        </p>
      </div>
      <p>
        A modern website for renting workspace for small and medium-sized
        businesses. Designed and simplified for maximum conversion.
      </p>
      <a
        href="https://www.figma.com/design/aaX9vZi3PTb3Tdhv6DerUC/Coworking-CaseStudy?node-id=0-1&t=9G5rIN92VK31E5Wo-1"
        target="_blank"
        class="font-medium bg-neutral-500/20 backdrop-blur-[2px]
          md:w-fit px-8 py-3 text-white border border-white/20 rounded-full duration-200 text-center hover:shadow-[0px_0px_10px_rgba(255,255,255,0.6)] hover:border-white/60"
      >
        View case study
      </a>
    </div>
    <div
      class="col-span-3 content-center md:content-center lg:col-span-2 order-first lg:order-none"
    >
      <img src={coworkingWebsite.src} alt="DropShoes" />
    </div>
  </div>
  {/* Second project - start section */}
  {/* Thrid project - start section */}
  <div
    class="w-full mt-12 bg-neutral-900/40 backdrop-blur-md rounded-3xl text-stone-400 border border-neutral-800 p-8 md:p-12 grid grid-cols-2 md:grid-cols-3 h-auto gap-6 md:content-center"
  >
    <div class="col-span-2 lg:col-span-1 flex flex-col gap-4 justify-center">
      <h2
        class="text-transparent bg-clip-text bg-gradient-to-r from-neutral-50 to-neutral-400 text-4xl"
      >
        Portfolio for <span
          class="italic"
          style="font-family: 'Instrument Serif', serif;">digital</span
        > artist
      </h2>
      <div class="w-auto gap-2 flex">
        <p
          class="py-1 px-4 bg-black rounded-4xl border-1 border-neutral-700 my-1 w-fit"
        >
          UI Design
        </p>
        <p
          class="py-1 px-4 bg-black rounded-4xl border-1 border-neutral-700 my-1 w-fit"
        >
          UX Design
        </p>
      </div>
      <p>
        Clean, modern portfolio template designed for digital artists who want
        to showcase their work professionally. Built in Figma
      </p>
      <a
        href="https://www.figma.com/design/gnOws9Y6OLgiLtqMG8NS0O/Template?node-id=0-1&t=oaFkmYVeMPBpNJG7-1"
        target="_blank"
        class="font-medium bg-neutral-500/20 backdrop-blur-[2px]
          md:w-fit px-8 py-3 text-white border border-white/20 rounded-full duration-200 text-center hover:shadow-[0px_0px_10px_rgba(255,255,255,0.6)] hover:border-white/60"
      >
        View case study
      </a>
    </div>
    <div
      class="col-span-3 content-center md:content-center lg:col-span-2 order-first lg:order-none"
    >
      <img src={digitalArtist.src} alt="DropShoes" />
    </div>
  </div>
  {/* Thrid project - start section */}
</section>

---
import analyss from "../assets/Analyss-img.webp";
import projectSectionBg from "../assets/bg-portfolio.png";
import coworkingWebsite from "../assets/coworking_hero.png";
import dobreCv from "../assets/Dobre-cv-img.webp";

const projects = [
  {
    title: "Analyss -",
    titleItalic: "AI",
    suffix: "Tool",
    tags: ["UI Design", "UX Design", "Development", "DevOps"],
    description:
      "Ghost job postings make up about half of all job ads. Analyss solves this problem with a modern AI job-listing scanner and helps refine your CV using a dedicated verification algorithm.",
    href: "https://analyss.vercel.app/",
    cta: "Test project",
    image: analyss.src,
    alt: "Analyss - CV and job offer scaner",
  },
  {
    title: "Website for",
    titleItalic: "coworking",
    suffix: "office",
    tags: ["UI Design", "UX Design"],
    description:
      "A modern website for renting workspace for small and medium-sized businesses. Designed for maximum conversion.",
    href: "https://www.figma.com/design/aaX9vZi3PTb3Tdhv6DerUC/Coworking-CaseStudy?node-id=0-1&t=9G5rIN92VK31E5Wo-1",
    cta: "View case study",
    image: coworkingWebsite.src,
    alt: "Coworking office website",
  },
  {
    title: "Dobre CV -",
    titleItalic: "Website",
    suffix: "",
    tags: ["UI Design", "UX Design", "Web development"],
    description:
      "Clear website with modern UI deploy in Framer for Dobre-CV.",
    href: "https://dobre-cv.framer.website/",
    cta: "View website",
    image: dobreCv.src,
    alt: "Dobre-CV website",
  },
];
---

<section
  id="portfolio"
  class="relative w-full bg-black py-24 px-6 md:px-12 overflow-hidden"
>
  <!-- Background -->
  <div
    class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-30 md:bg-contain pointer-events-none"
    style={{ backgroundImage: `url(${projectSectionBg.src})` }}
  >
  </div>
  <div
    class="absolute inset-0 bg-[linear-gradient(to_bottom,black_0%,transparent_15%,transparent_85%,black_100%)] pointer-events-none"
  >
  </div>

  <div class="relative max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col items-center gap-4 text-center mb-16">
      <span
        class="inline-block bg-black px-4 py-2 rounded-full text-stone-400 border border-[#3F3E3E] text-sm"
        data-i18n="projects.badge"
      >
        Projects
      </span>
      <h1
        class="text-transparent bg-clip-text bg-gradient-to-r from-white to-neutral-400 font-medium text-4xl md:text-5xl leading-tight"
        data-i18n="projects.title"
      >
        Few selected projects
      </h1>
      <p class="text-stone-400 leading-relaxed max-w-lg" data-i18n="projects.subtitle">
        A showcase of innovative solutions that solve real-world digital
        challenges.
      </p>
    </div>

    <!-- Project cards — one per row -->
    <div class="flex flex-col gap-6">
      {
        projects.map((p, i) => (
          <div class="group relative flex flex-col overflow-hidden rounded-3xl border border-neutral-800 bg-neutral-900/30 backdrop-blur-sm">
            <!-- Lamp glow on hover — brightens from bottom -->
            <div class="absolute inset-0 bg-gradient-to-t from-neutral-300/[0.07] via-neutral-500/[0.03] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none rounded-3xl" />
            <div class="absolute bottom-0 left-0 right-0 h-1/2 bg-gradient-to-t from-white/[0.04] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none" />

            <!-- Text — top, centered -->
            <div class="relative flex flex-col items-center text-center gap-5 px-8 pt-10 pb-8 z-10">
              <h2 class="text-transparent bg-clip-text bg-gradient-to-r from-white to-neutral-400 font-medium text-2xl md:text-3xl leading-tight">
                <span data-i18n={`projects.items.${i}.title`}>{p.title}</span>{" "}
                <span data-i18n={`projects.items.${i}.titleItalic`}>{p.titleItalic}</span>{" "}
                <span data-i18n={`projects.items.${i}.suffix`}>{p.suffix}</span>
              </h2>

              <div class="flex gap-2 flex-wrap justify-center">
                {p.tags.map((tag, ti) => (
                  <span class="py-1 px-4 bg-black/60 rounded-full border border-neutral-700 text-stone-400 text-sm" data-i18n={`projects.items.${i}.tags.${ti}`}>
                    {tag}
                  </span>
                ))}
              </div>

              <p class="text-stone-500 text-base leading-relaxed max-w-xl" data-i18n={`projects.items.${i}.description`}>
                {p.description}
              </p>

              <a
                href={p.href}
                target={p.href !== "#" ? "_blank" : undefined}
                class="text-sm font-medium px-7 py-3 text-white border border-white/20 rounded-full bg-neutral-500/20 hover:border-white/50 hover:shadow-[0_0_12px_rgba(255,255,255,0.15)] transition-all duration-200"
                data-i18n={`projects.items.${i}.cta`}
              >
                {p.cta}
              </a>
            </div>

            <!-- Image — clipped container, image slides up on hover -->
            <div class="relative overflow-hidden h-[200px] sm:h-[380px] md:h-[560px] mx-6 mb-0">
              <img
                src={p.image}
                alt={p.alt}
                class="w-full h-auto object-cover object-top rounded-t-2xl translate-y-8 group-hover:translate-y-0 transition-transform duration-500 ease-out"
              />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
